# Production Environment Configuration
# IMPORTANTE: Nunca commitar este arquivo com valores reais!

# Application
FLASK_ENV=production

# Database
POSTGRES_DB=email_analyzer_prod
POSTGRES_USER=email_analyzer_user
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_MIN_32_CHARS

# Redis
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD

# AI Service
GEMINI_API_KEY=your_production_gemini_api_key_here

# Security
SECRET_KEY=CHANGE_THIS_SECRET_KEY_MIN_32_CHARS_RANDOM

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=10

# Logging
LOG_LEVEL=INFO

# Monitoring (opcional)
SENTRY_DSN=https://your-sentry-dsn-here

# CORS (domínios permitidos, separados por vírgula)
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# SSL/TLS (se usar HTTPS)
TALISMAN_FORCE_HTTPS=true
